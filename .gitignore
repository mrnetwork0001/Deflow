# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Secrets — never commit real Alpaca or Featherless keys
.env
.env.local

# Runtime state: the ledger, position book and IV history are generated by the
# desk. The ledger is per-account and per-run; committing one would mix another
# machine's decisions into your audit chain.
data/*.jsonl
data/*.json
!data/.gitkeep

# Node / Next.js
node_modules/
.next/
next-env.d.ts
web/.next/
web/node_modules/
*.tsbuildinfo

# The built dashboard IS committed, so `python main.py` serves a UI from a bare
# clone with no Node toolchain. Remove the negation to build it locally instead.
!web/out/

# Local container volume mount
data-docker/

# OS
.DS_Store
