# ---------------------------------------------------------------------------
# Alpaca paper trading credentials
# ---------------------------------------------------------------------------
# Create a FRESH paper account for the hackathon (reused accounts are not
# eligible) and set its starting balance to $100,000:
#   https://app.alpaca.markets/paper/dashboard/overview
#
# These names match Alpaca's official CLI and MCP server exactly, so the same
# .env drives all three. ALPACA_API_KEY_ID / APCA_API_KEY_ID also work.
ALPACA_API_KEY=PK00000000000000000000
ALPACA_SECRET_KEY=0000000000000000000000000000000000000000

# Paper only. Deflow refuses to start against a non-paper endpoint.
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# ---------------------------------------------------------------------------
# Featherless AI — reasoning layer (hackathon technology partner)
# ---------------------------------------------------------------------------
# Optional. Without it the desk falls back to its deterministic ranker and
# says so in every ledger entry. Get $25 of credits at featherless.ai.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen2.5-72B-Instruct

# ---------------------------------------------------------------------------
# Desk configuration (all optional — these are the defaults)
# ---------------------------------------------------------------------------
DEFLOW_UNIVERSE=SPY,QQQ,IWM,NVDA,AAPL,MSFT,AMD,TSLA
DEFLOW_CYCLE_SECONDS=300
DEFLOW_PORT=8000

# Risk envelope. Note these configure the *desk*; the hard limits compiled into
# risk_gate.py are the real ceiling and cannot be widened from here.
DEFLOW_STARTING_EQUITY=100000
DEFLOW_MAX_RISK_PCT=0.02
DEFLOW_MAX_NET_DELTA=0.35

# Order routing: auto | cli | rest | paper
DEFLOW_EXECUTION_ROUTE=auto
# Render orders without submitting them.
DEFLOW_DRY_RUN=false

# Override the MCP launch command if you have the server installed directly.
# DEFLOW_MCP_COMMAND=alpaca-mcp-server

# The day this desk's mandate ends (ISO date), empty for an open-ended desk.
# Approaching it the desk takes profits earlier; ON that day it opens nothing
# and flattens the book from the UTC time below, so the period closes with
# realised results rather than marks. AFTER it, the mandate has simply expired
# and the desk resumes ordinary trading -- a reporting deadline closes the
# books on a period, it does not close the desk.
DEFLOW_MANDATE_END=
DEFLOW_MANDATE_FLATTEN_UTC=14:00
